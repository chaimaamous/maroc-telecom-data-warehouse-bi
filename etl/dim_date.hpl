  <transform>
    <type>TableInput</type>
    <name>lire_date</name>
    <sql>SELECT DISTINCT
date_emission AS date_complete,
DAY(date_emission) AS jour,
MONTH(date_emission) AS mois,
MONTHNAME(date_emission) AS nom_mois,
QUARTER(date_emission) AS trimestre,
YEAR(date_emission) AS annee
FROM facture;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
